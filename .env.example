# Copy to .env and enter credentials locally. Read by the backend only.
FINNHUB_API_KEY=
# Gemini key from https://aistudio.google.com/apikey (news analysis)
GEMINI_API_KEY=

# Optional: disabled; revisit during Phase 6
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only when the backend is reachable from outside this machine (tunnel + hosted
# frontend). API_TOKEN gates every /api call; ALLOWED_ORIGINS is a comma-separated
# list of extra browser origins allowed to call it directly. Leave both empty for
# a local-only setup.
API_TOKEN=
ALLOWED_ORIGINS=
